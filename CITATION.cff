  - "LLM evaluation"
  - "retrieval-augmented generation"
  - "RAG evaluation"
  - "AI agents"
  - "regression detection"
  - "MLOps"
  - "LLMOps"
  - "continuous evaluation"
  - "software quality"
version: "0.1.0"
